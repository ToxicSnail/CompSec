/*
 Индивидуальная лабораторная 3 (вариант 3)

 Три процесса образуют кольцо с однонаправленными асинхронными каналами емкости 1.
 У каждого процесса есть булева переменная b[i], которая в начале принимает
 произвольное значение. Ровно два раза каждый процесс выполняет:
   1) отправляет в исходящий канал свое текущее значение b[i];
   2) принимает одно значение из входящего канала и, если получено true,
      устанавливает b[i] := true.

 Требуется убедиться, что:
  - каждый процесс рано или поздно завершит свою последовательность действий;
  - в конце все процессы хранят true тогда и только тогда, когда хотя бы один
    процесс в начале хранил true;
  - в конце все процессы хранят false тогда и только тогда, когда ни один
    процесс в начале не хранил true.
*/

#define N 3

chan ch[N] = [1] of { bool };     /* ch[i] — от i к (i+1)%N */

bool b[N];        /* текущее значение процесса i */
bool init_b[N];   /* значение процесса i в самом начале */
bool done[N];     /* флаг завершения процесса i */

#define PREV(i) ((N + (i) - 1) % N)
#define NEXT(i) (((i) + 1) % N)

proctype Node(byte id)
{
    bool v;
    byte r = 0;

    do
    :: (r < 2) ->
        /* 1) отправляем свое текущее значение */
        ch[id]!b[id];
        /* 2) читаем из входящего канала и при true поднимаем свое b */
        ch[PREV(id)]?v;
        if
        :: v -> b[id] = true
        :: else -> skip
        fi;
        r++
    :: else ->
        done[id] = true;
        break
    od
}

/* Свойства после завершения всех процессов */
#define SOMEONE_INIT_TRUE (init_b[0] || init_b[1] || init_b[2])
#define ALL_FINAL_TRUE    (b[0] && b[1] && b[2])
#define ALL_FINAL_FALSE   ((!b[0]) && (!b[1]) && (!b[2]))

ltl all_finish { <> (done[0] && done[1] && done[2]) }

init
{
    byte i = 0;

    /* Инициализация: каждому процессу выбираем произвольное начальное b */
    atomic {
        do
        :: i < N ->
            if
            :: b[i] = false
            :: b[i] = true
            fi;
            init_b[i] = b[i];
            done[i] = false;
            i++
        :: else -> break
        od
    }

    /* Запуск кольца: ch[i] — от i к i+1 */
    run Node(0);
    run Node(1);
    run Node(2);

    /* Дожидаемся завершения всех для проверки пост‑условий */
    do
    :: (done[0] && done[1] && done[2]) -> break
    od;

    /* Эквивалентности из задания */
    assert(ALL_FINAL_TRUE  == SOMEONE_INIT_TRUE);
    assert(ALL_FINAL_FALSE == (!SOMEONE_INIT_TRUE));
}

/*
Подсказки по проверке в SPIN:
  spin -a ind_lab3/ind_lab3.pml
  gcc -O2 pan.c -o pan
  ./pan -a            # поиск ошибок безопасности/дедлоков и assert'ов
  ./pan -N all_finish # проверка LTL-свойства завершения
*/
